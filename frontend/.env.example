# Backend URL used by the server-side Next.js API rewrite.
VANE_API_URL=http://localhost:8100

# Optional in local development. Defaults to ws(s)://<browser-host>:8100/ws/sector-flow.
# Set this to the public WSS endpoint when deploying behind another hostname.
# NEXT_PUBLIC_SECTOR_FLOW_WS_URL=ws://localhost:8100/ws/sector-flow
